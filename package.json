{
  "name": "mathvoice",
  "version": "0.4.0",
  "license": "MIT",
  "description": "Entorno matemático en español, pensado para trabajar sin mirar la pantalla.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write src tests tests-pwa scripts docs *.json *.ts *.js *.md",
    "check:bundle": "node scripts/check-bundle.mjs",
    "test:e2e": "playwright test",
    "test:pwa": "npm run build && playwright test --config playwright.pwa.config.ts"
  },
  "keywords": [],
  "author": "",
  "type": "module",
  "dependencies": {
    "jstat": "^1.9.6",
    "mathjs": "^15.2.0",
    "ml-matrix": "^6.15.0",
    "nerdamer": "^1.1.13",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "prettier": "^3.9.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1"
  },
  "private": true
}
